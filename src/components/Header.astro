---
import type { Settings } from '../lib/reader';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <img src={settings.logo} alt="Minds and Muscles" width="211" height="70" />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Otwórz menu">
      <span></span>
    </label>

    <nav class="site-nav" aria-label="Nawigacja główna">
      <ul>
        {settings.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href={settings.headerCta.href} class="button button--primary site-header__cta">
      {settings.headerCta.label}
    </a>
  </div>
</header>

<style>
  .site-header {
    padding-block: var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    position: sticky;
    top: 0;
    background: var(--c-white);
    z-index: 50;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .site-header__logo img {
    height: 44px;
    width: auto;
  }

  .site-nav {
    margin-inline-start: auto;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    color: var(--c-ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--c-primary);
  }

  .site-header__cta {
    padding-block: var(--space-2);
    padding-inline: var(--space-6);
    min-height: 40px;
    flex-shrink: 0;
  }

  .nav-toggle,
  .nav-toggle-label {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-toggle-label {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-inline-start: auto;
      cursor: pointer;
    }

    .nav-toggle-label span,
    .nav-toggle-label span::before,
    .nav-toggle-label span::after {
      content: '';
      display: block;
      width: 22px;
      height: 2px;
      background: var(--c-ink);
      position: relative;
      transition: transform 0.2s ease;
    }

    .nav-toggle-label span::before {
      position: absolute;
      top: -7px;
    }

    .nav-toggle-label span::after {
      position: absolute;
      top: 7px;
    }

    .site-nav {
      order: 10;
      flex-basis: 100%;
      margin-inline-start: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .site-nav ul {
      flex-direction: column;
      gap: var(--space-3);
      padding-block: var(--space-4);
    }

    .nav-toggle:checked ~ .site-nav {
      max-height: 400px;
    }
  }
</style>
