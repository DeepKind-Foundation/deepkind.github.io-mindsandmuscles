---
interface Props {
  text: string;
  acceptLabel: string;
  declineLabel: string;
  /** Google Analytics Measurement ID (G-XXXXXXXXXX). Empty/undefined keeps analytics fully disabled — see the script below. */
  gaMeasurementId?: string;
}

const { text, acceptLabel, declineLabel, gaMeasurementId } = Astro.props;
---

<div
  class="cookie-banner"
  id="cookie-banner"
  role="region"
  aria-label="Informacja o plikach cookies"
  data-ga-id={gaMeasurementId}
  hidden
>
  <p class="cookie-banner__text">{text}</p>
  <div class="cookie-banner__actions">
    <button type="button" class="cookie-banner__decline" id="cookie-decline">{declineLabel}</button>
    <button type="button" class="cookie-banner__accept" id="cookie-accept">{acceptLabel}</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-4);
    font-size: 0.875rem;
    color: var(--c-white);
    background: color-mix(in oklch, var(--c-ink) 92%, transparent);
    border-top: 1px solid color-mix(in oklch, var(--c-white) 25%, transparent);
    box-shadow: 0 -12px 32px color-mix(in oklch, var(--c-ink) 55%, transparent);
    backdrop-filter: blur(20px);
  }
  .cookie-banner[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cookie-banner {
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    @starting-style {
      .cookie-banner:not([hidden]) {
        opacity: 0;
        transform: translateY(1.5rem);
      }
    }
  }

  .cookie-banner__text {
    text-align: center;
    max-width: 56rem;
    margin: 0;
  }
  .cookie-banner__actions {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-3);
  }
  .cookie-banner__accept,
  .cookie-banner__decline {
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    font-weight: 600;
    border: 0;
    padding: var(--space-2) var(--space-6);
    border-radius: 999px;
    transition: background-color 0.2s ease;
  }
  .cookie-banner__decline {
    color: var(--c-white);
    background: oklch(45% 0.02 283);
  }
  .cookie-banner__decline:hover {
    background: oklch(52% 0.02 283);
  }
  .cookie-banner__accept {
    color: var(--c-white);
    background: var(--c-primary);
  }
  .cookie-banner__accept:hover {
    background: var(--c-primary-hover);
  }

  @media (min-width: 768px) {
    .cookie-banner {
      flex-direction: row;
    }
    .cookie-banner__text {
      text-align: left;
    }
  }
</style>

<style is:global>
  body {
    transition: padding-bottom 0.25s ease;
  }
</style>

<script>
  declare global {
    interface Window {
      dataLayer: unknown[];
    }
  }

  const STORAGE_KEY = 'mm-cookie-consent';
  const PRODUCTION_HOSTNAME = 'mindsandmuscles.pl';
  const ENTRANCE_DELAY_MS = 400;
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  const decline = document.getElementById('cookie-decline');

  function loadAnalytics(measurementId: string): void {
    if (window.location.hostname !== PRODUCTION_HOSTNAME) return;
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer ?? [];
    function gtag(..._args: unknown[]) {
      window.dataLayer.push(arguments);
    }
    gtag('js', new Date());
    gtag('config', measurementId);
  }

  if (banner && accept && decline) {
    let consent: string | null = null;
    try {
      consent = localStorage.getItem(STORAGE_KEY);
    } catch {
      consent = null;
    }

    const gaId = banner.dataset.gaId;
    if (consent === 'accepted' && gaId) {
      loadAnalytics(gaId);
    }

    if (consent !== 'accepted' && consent !== 'declined') {
      setTimeout(() => {
        banner.hidden = false;
        const reserveSpace = () => {
          document.body.style.paddingBottom = `${banner.offsetHeight}px`;
        };
        reserveSpace();
        new ResizeObserver(reserveSpace).observe(banner);
      }, ENTRANCE_DELAY_MS);
    }

    const dismiss = (value: 'accepted' | 'declined') => {
      banner.hidden = true;
      document.body.style.paddingBottom = '';
      try {
        localStorage.setItem(STORAGE_KEY, value);
      } catch {
        /* empty */
      }
    };

    accept.addEventListener('click', () => {
      dismiss('accepted');
      if (gaId) loadAnalytics(gaId);
    });

    decline.addEventListener('click', () => {
      dismiss('declined');
    });
  }
</script>
