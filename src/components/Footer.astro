---
import type { Settings } from '../lib/reader';

interface Props {
  settings: Settings;
}

const { footer } = Astro.props.settings;
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__col">
      <img
        src="/images/site/footer-logo.webp"
        alt="Minds and Muscles"
        width="120"
        height="120"
        class="site-footer__logo"
      />
      <p>{footer.aboutText}</p>
    </div>

    <div class="site-footer__col">
      <h2>{footer.linksHeading}</h2>
      <ul>
        {footer.links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="site-footer__col">
      <h2>{footer.contactHeading}</h2>
      <p>{footer.phone}<br /><a href={`mailto:${footer.email}`}>{footer.email}</a></p>
      <div class="site-footer__social">
        <a href={footer.facebookUrl} aria-label="Facebook" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href={footer.instagramUrl} aria-label="Instagram" target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>{footer.copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-ink);
    color: var(--c-surface);
    padding-block: var(--space-16) var(--space-8);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .site-footer h2 {
    color: var(--c-white);
    font-size: 1.1rem;
    margin-bottom: var(--space-4);
  }

  .site-footer p {
    color: color-mix(in srgb, var(--c-surface) 85%, transparent);
  }

  .site-footer a {
    color: var(--c-surface);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--c-accent);
  }

  .site-footer__logo {
    margin-bottom: var(--space-4);
    border-radius: var(--radius);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .site-footer__bottom {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid color-mix(in srgb, var(--c-surface) 20%, transparent);
    font-size: 0.85rem;
  }

  .site-footer__bottom p {
    margin: 0;
    color: color-mix(in srgb, var(--c-surface) 65%, transparent);
  }

  @media (max-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
