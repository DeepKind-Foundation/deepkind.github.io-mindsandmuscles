---
import PostCard from '../PostCard.astro';

interface PostSummary {
  slug: string;
  title: string;
  featuredImage: string;
  featuredImageAlt: string;
}

interface Props {
  heading: string;
  intro: string;
  buttonLabel: string;
  buttonHref: string;
  posts: PostSummary[];
}

const { heading, intro, buttonLabel, buttonHref, posts } = Astro.props;
---

<section id="strefa-wiedzy" class="blog-teaser section section--surface">
  <div class="container">
    <header class="blog-teaser__header">
      <h2>{heading}</h2>
      <p>{intro}</p>
    </header>

    <div class="blog-teaser__grid">
      {posts.map((post, i) => (
        <PostCard
          slug={post.slug}
          title={post.title}
          image={post.featuredImage}
          imageAlt={post.featuredImageAlt}
          linkLabel="Więcej →"
          headingLevel={i === 0 ? 'h2' : 'h3'}
          featured={i === 0}
        />
      ))}
    </div>

    <div class="blog-teaser__cta">
      <a href={buttonHref} class="button button--outline">{buttonLabel}</a>
    </div>
  </div>
</section>

<style>
  .blog-teaser__header {
    max-width: 640px;
    margin-bottom: var(--space-12);
  }

  /* Newest post (first) is featured larger, spanning both rows of a narrower
     2-up column — an editorial split instead of a uniform 3-card row. */
  .blog-teaser__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(2, auto);
    gap: var(--space-8);
  }

  .blog-teaser__grid > :global(a:first-child) {
    grid-row: 1 / span 2;
  }

  .blog-teaser__cta {
    margin-top: var(--space-12);
    text-align: center;
  }

  @media (max-width: 860px) {
    .blog-teaser__grid {
      grid-template-columns: 1fr;
    }

    .blog-teaser__grid > :global(a:first-child) {
      grid-row: auto;
    }
  }
</style>
