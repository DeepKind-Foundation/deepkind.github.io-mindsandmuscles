---
import PostCard from '../PostCard.astro';

interface PostSummary {
  slug: string;
  title: string;
  featuredImage: string;
  featuredImageAlt: string;
}

interface Props {
  heading: string;
  intro: string;
  buttonLabel: string;
  buttonHref: string;
  posts: PostSummary[];
}

const { heading, intro, buttonLabel, buttonHref, posts } = Astro.props;
---

<section id="strefa-wiedzy" class="blog-teaser section section--surface">
  <div class="container">
    <header class="blog-teaser__header">
      <h2>{heading}</h2>
      <p>{intro}</p>
    </header>

    <div class="blog-teaser__grid">
      {posts.map((post) => (
        <PostCard
          slug={post.slug}
          title={post.title}
          image={post.featuredImage}
          imageAlt={post.featuredImageAlt}
          linkLabel="Więcej →"
        />
      ))}
    </div>

    <div class="blog-teaser__cta">
      <a href={buttonHref} class="button button--outline">{buttonLabel}</a>
    </div>
  </div>
</section>

<style>
  .blog-teaser__header {
    max-width: 640px;
    margin-bottom: var(--space-12);
  }

  .blog-teaser__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .blog-teaser__cta {
    margin-top: var(--space-12);
    text-align: center;
  }

  @media (max-width: 860px) {
    .blog-teaser__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
