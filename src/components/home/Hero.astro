---
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  illustration: string;
  illustrationAlt: string;
}

const {
  eyebrow,
  heading,
  body,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  illustration,
  illustrationAlt,
} = Astro.props;

const headingLines = heading.split('\n');
---

<section id="home" class="hero section">
  <div class="container hero__grid">
    <div class="hero__heading">
      <span class="eyebrow">{eyebrow}</span>
      <h1>
        {headingLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
    </div>
    <div class="hero__lower">
      <p class="hero__body">{body}</p>
      <div class="hero__actions">
        <a href={primaryCtaHref} class="button button--primary" target="_blank" rel="noopener noreferrer">
          {primaryCtaLabel}
        </a>
        <a href={secondaryCtaHref} class="hero__link">{secondaryCtaLabel} →</a>
      </div>
    </div>
    <img
      class="hero__illustration"
      src={illustration}
      alt={illustrationAlt}
      width="1200"
      height="351"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-8);
    background: linear-gradient(180deg, var(--c-surface), var(--c-white));
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    /* Row 1's third column is deliberately empty — the illustration (row 2) is
       rotated and overflows upward into it. Not a layout bug. */
    grid-template-areas:
      'heading heading heading'
      'lower illustration illustration';
    column-gap: var(--space-12);
    row-gap: var(--space-6);
  }

  .hero__heading {
    grid-area: heading;
    position: relative;
    z-index: 2;
  }

  .hero__lower {
    grid-area: lower;
    position: relative;
    z-index: 2;
    align-self: start;
  }

  .hero__illustration {
    grid-area: illustration;
    display: block;
    width: 90%;
    height: auto;
    margin-inline-start: auto;
    align-self: end;
    /* Muted so the illustration reads as a secondary accent, not the focal
       point — kept as a custom property (with --illustration-rotation below)
       so the entry animation can end at these exact values instead of the
       keyframe's own end-state silently overriding them. */
    --illustration-opacity: 0.55;
    --illustration-rotation: -3deg;
    opacity: var(--illustration-opacity);
    transform: rotate(var(--illustration-rotation));
  }

  /* Entry reveal, staggered heading -> body/CTA -> illustration (reading order).
     Opacity and rotation are folded into the keyframe itself (via the custom
     properties, defaulting to fully-opaque/0deg for the non-illustration
     elements) so they survive past the animation's fill-mode instead of being
     wiped by the animated opacity/transform. */
  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(12px) rotate(var(--illustration-rotation, 0deg));
    }
    to {
      opacity: var(--illustration-opacity, 1);
      transform: translateY(0) rotate(var(--illustration-rotation, 0deg));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__heading,
    .hero__lower,
    .hero__illustration {
      animation: hero-reveal 0.4s ease both;
    }

    .hero__heading {
      animation-delay: 0ms;
    }

    .hero__lower {
      animation-delay: 100ms;
    }

    .hero__illustration {
      animation-delay: 200ms;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-16) var(--space-8);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'heading'
        'lower'
        'illustration';
    }

    .hero__illustration {
      margin-top: var(--space-8);
      --illustration-rotation: -2deg;
      transform: rotate(var(--illustration-rotation));
    }
  }

  .hero__body {
    font-style: italic;
    font-size: 1.15rem;
    color: var(--c-body);
    max-width: 640px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .hero__link {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .hero__link:hover {
    color: var(--c-primary);
  }
</style>
