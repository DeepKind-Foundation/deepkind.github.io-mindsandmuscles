---
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
}

const { eyebrow, heading, body, primaryCtaLabel, primaryCtaHref, secondaryCtaLabel, secondaryCtaHref } =
  Astro.props;
---

<section id="home" class="hero section">
  <div class="container hero__inner">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{heading}</h1>
    <p class="hero__body">{body}</p>
    <div class="hero__actions">
      <a href={primaryCtaHref} class="button button--primary" target="_blank" rel="noopener noreferrer">
        {primaryCtaLabel}
      </a>
      <a href={secondaryCtaHref} class="button button--outline">{secondaryCtaLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-24) var(--space-16);
    background: linear-gradient(180deg, var(--c-surface), var(--c-white));
  }

  .hero__inner {
    max-width: 820px;
  }

  .hero__body {
    font-size: 1.15rem;
    color: var(--c-body);
    max-width: 640px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
</style>
