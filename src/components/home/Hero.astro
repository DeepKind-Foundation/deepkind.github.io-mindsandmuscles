---
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
}

const { eyebrow, heading, body, primaryCtaLabel, primaryCtaHref, secondaryCtaLabel, secondaryCtaHref } =
  Astro.props;
---

<section id="home" class="hero section">
  <div class="container">
    <div class="hero__inner">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{heading}</h1>
      <p class="hero__body">{body}</p>
      <div class="hero__actions">
        <a href={primaryCtaHref} class="button button--primary" target="_blank" rel="noopener noreferrer">
          {primaryCtaLabel}
        </a>
        <a href={secondaryCtaHref} class="hero__link">{secondaryCtaLabel} →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: calc(100vh - 80px);
    padding-block: var(--space-16);
    background: linear-gradient(180deg, var(--c-surface), var(--c-white));
  }

  .hero__inner {
    max-width: 820px;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding-block: var(--space-16) var(--space-12);
    }
  }

  .hero__body {
    font-style: italic;
    font-size: 1.15rem;
    color: var(--c-body);
    max-width: 640px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .hero__link {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
  }

  .hero__link:hover {
    color: var(--c-primary);
  }
</style>
