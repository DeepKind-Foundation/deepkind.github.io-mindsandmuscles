---
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  illustration: string;
  illustrationAlt: string;
}

const {
  eyebrow,
  heading,
  body,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  illustration,
  illustrationAlt,
} = Astro.props;
---

<section id="home" class="hero section">
  <div class="container">
    <div class="hero__inner">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{heading}</h1>
      <p class="hero__body">{body}</p>
      <div class="hero__actions">
        <a href={primaryCtaHref} class="button button--primary" target="_blank" rel="noopener noreferrer">
          {primaryCtaLabel}
        </a>
        <a href={secondaryCtaHref} class="hero__link">{secondaryCtaLabel} →</a>
      </div>
    </div>
    <img
      class="hero__illustration"
      src={illustration}
      alt={illustrationAlt}
      width="1200"
      height="385"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-8);
    background: linear-gradient(180deg, var(--c-surface), var(--c-white));
  }

  .hero__inner {
    max-width: 820px;
  }

  .hero__illustration {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-16);
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-16) var(--space-8);
    }

    .hero__illustration {
      margin-top: var(--space-12);
    }
  }

  .hero__body {
    font-style: italic;
    font-size: 1.15rem;
    color: var(--c-body);
    max-width: 640px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .hero__link {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
  }

  .hero__link:hover {
    color: var(--c-primary);
  }
</style>
