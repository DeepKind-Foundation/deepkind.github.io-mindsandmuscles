---
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  illustration: string;
  illustrationAlt: string;
}

const {
  eyebrow,
  heading,
  body,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  illustration,
  illustrationAlt,
} = Astro.props;

const headingLines = heading.split('\n');
---

<section id="home" class="hero section">
  <div class="container hero__grid">
    <div class="hero__heading">
      <span class="eyebrow">{eyebrow}</span>
      <h1>
        {headingLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h1>
    </div>
    <div class="hero__lower">
      <p class="hero__body">{body}</p>
      <div class="hero__actions">
        <a href={primaryCtaHref} class="button button--primary" target="_blank" rel="noopener noreferrer">
          {primaryCtaLabel}
        </a>
        <a href={secondaryCtaHref} class="hero__link">{secondaryCtaLabel} →</a>
      </div>
    </div>
    <img
      class="hero__illustration"
      src={illustration}
      alt={illustrationAlt}
      width="1200"
      height="351"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-8);
    background: linear-gradient(180deg, var(--c-surface), var(--c-white));
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-areas:
      'heading heading heading'
      'lower illustration illustration';
    column-gap: var(--space-12);
    row-gap: var(--space-6);
  }

  .hero__heading {
    grid-area: heading;
    position: relative;
    z-index: 2;
  }

  .hero__lower {
    grid-area: lower;
    position: relative;
    z-index: 2;
    align-self: start;
  }

  .hero__illustration {
    grid-area: illustration;
    display: block;
    width: 90%;
    height: auto;
    margin-inline-start: auto;
    align-self: end;
    opacity: 0.55;
    transform: rotate(-3deg);
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-16) var(--space-8);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'heading'
        'lower'
        'illustration';
    }

    .hero__illustration {
      margin-top: var(--space-8);
      transform: rotate(-2deg);
    }
  }

  .hero__body {
    font-style: italic;
    font-size: 1.15rem;
    color: var(--c-body);
    max-width: 640px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .hero__link {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
  }

  .hero__link:hover {
    color: var(--c-primary);
  }
</style>
