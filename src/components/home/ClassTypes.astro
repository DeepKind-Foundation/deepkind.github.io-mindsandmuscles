---
interface ClassItem {
  image: string;
  alt: string;
  label: string;
  body: string;
}

interface Props {
  heading: string;
  items: readonly ClassItem[];
}

const { heading, items } = Astro.props;
---

<section id="rodzaje-zajec" class="class-types section">
  <div class="container">
    <h2>{heading}</h2>
    <div class="class-types__grid">
      {items.map((item) => (
        <article class="class-types__item">
          {/* Source images are ~100px native — the legacy site displayed them
              as small thumbnails overlapping the card's top edge, not
              full-width photos. Sized and positioned to match. */}
          <img src={item.image} alt={item.alt} width="100" height="100" loading="lazy" />
          <p class="class-types__label">{item.label}</p>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .class-types__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    margin-top: var(--space-16);
  }

  .class-types__item {
    position: relative;
    background: var(--c-surface);
    border-radius: var(--radius);
    padding: var(--space-8) var(--space-6) var(--space-6);
  }

  .class-types__item img {
    width: 100px;
    height: 100px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin: -40px 0 var(--space-4) var(--space-2);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--c-ink) 20%, transparent);
  }

  .class-types__label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-ink);
    margin: 0 0 var(--space-3);
  }

  .class-types__item p:not(.class-types__label) {
    font-size: 0.95rem;
    margin: 0;
  }

  @media (max-width: 860px) {
    .class-types__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
