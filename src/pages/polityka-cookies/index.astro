---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Polityka cookies — Minds and Muscles"
  description="Polityka cookies Minds and Muscles."
  noindex={true}
>
  <section class="policy section">
    <div class="container policy__inner">
      <h1>Polityka cookies</h1>
      <p class="policy__notice">
        Ta strona jest przygotowywana. Znajdzie się tu pełna treść polityki cookies —
        w tym miejscu tymczasowo brak ostatecznego tekstu.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .policy__inner {
    max-width: 720px;
  }

  .policy__notice {
    color: var(--c-body);
  }
</style>
